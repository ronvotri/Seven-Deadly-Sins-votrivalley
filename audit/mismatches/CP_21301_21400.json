  },
  {
    "index": 21332,
    "key": "SDS.MarriageDialogue.Maria.OneKid_4",
    "source": "Darling可以专心忙自己的事情，我会照顾好%kid1的$0",
    "target": "Darling cứ tập trung làm việc của mình đi, tôi sẽ chăm %kid1 thật tốt.$0",
